<Window x:Class="DragonVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dragon VPN" Width="720" Height="920" MinWidth="620" MinHeight="720"
        WindowStartupLocation="CenterScreen" Icon="Assets/dragon.ico" Background="#09070F">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F2EDF8"/><Setter Property="FontSize" Value="24"/>
            <Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="DrawerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F2EDF8"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/><Setter Property="Margin" Value="0,1"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Image Source="Assets/dragon_watermark.png" Stretch="UniformToFill" Opacity="0.42" />
        <Border Background="#A609070F" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="78"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#E609070F">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/><ColumnDefinition Width="60"/><ColumnDefinition Width="54"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MenuButton" Grid.Column="0" Content="☰" Style="{StaticResource IconButton}" Click="MenuButton_Click" />
                <TextBlock x:Name="ProfileTitle" Grid.Column="1" Text="Профиль" FontSize="27" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="DPI" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ToggleButton x:Name="DpiToggle" Width="54" Height="30" Checked="DpiToggle_Changed" Unchecked="DpiToggle_Changed">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Track" Background="#82778F" CornerRadius="15">
                                    <Ellipse x:Name="Thumb" Fill="#F2EDF8" Width="28" Height="28" HorizontalAlignment="Left" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="#B16CFF"/>
                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
                <Button Grid.Column="3" Content="▽" Style="{StaticResource IconButton}" Click="Filter_Click" />
                <Button Grid.Column="4" Content="⋮" Style="{StaticResource IconButton}" Click="More_Click" />
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#E609070F">
                <StackPanel x:Name="GroupTabs" Orientation="Horizontal">
                    <Button Content="Подписка (0)" Background="Transparent" FontSize="17" Padding="18,10" />
                    <Button Content="Ws (0)" Background="Transparent" FontSize="17" Padding="18,10" />
                    <Button Content="И (0)" Background="#3C1764" FontSize="17" Padding="18,10" BorderBrush="#B16CFF" BorderThickness="0,0,0,4" />
                    <Button Content="Тест (0)" Background="Transparent" FontSize="17" Padding="18,10" />
                </StackPanel>
            </ScrollViewer>
            <ListView x:Name="ProfilesList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#F2EDF8"
                      SelectionChanged="ProfilesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#303C1764"/></Trigger></Style.Triggers>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="138">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#B16CFF" />
                            <StackPanel Grid.Column="1" Margin="20,15,6,12">
                                <TextBlock Text="{Binding Name}" FontSize="23" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Endpoint}" FontSize="18" Foreground="#CEC4D8" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ProtocolLabel}" FontSize="15" Foreground="#B16CFF" Margin="0,10,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="⌯" Style="{StaticResource IconButton}" ToolTip="Поделиться" Click="ShareProfile_Click" />
                                <Button Content="✎" Style="{StaticResource IconButton}" ToolTip="Изменить" Click="EditProfile_Click" />
                                <Button Content="▣" Style="{StaticResource IconButton}" ToolTip="Удалить" Click="DeleteProfile_Click" />
                            </StackPanel>
                            <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1" Background="#443A4D" Margin="20,0" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="3" Background="#E609070F">
                <TextBlock x:Name="ConnectionStatus" Text="Нет соединения" FontSize="18" Foreground="#CEC4D8" Margin="26,0,120,0" VerticalAlignment="Center" />
                <Button x:Name="ConnectButton" Width="78" Height="78" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-38,26,0"
                        Background="#6D637A" Content="▶" FontSize="30" BorderThickness="0" Click="Connect_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="22"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                </Button>
            </Grid>
        </Grid>
        <Grid x:Name="DrawerShade" Visibility="Collapsed" Background="#99000000" MouseDown="DrawerShade_MouseDown" />
        <Grid x:Name="DrawerPanel" Width="500" HorizontalAlignment="Left" Visibility="Collapsed">
            <Image Source="Assets/dragon_watermark.png" Stretch="UniformToFill" Opacity="0.52" />
            <Border Background="#D9080010" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="34,210,20,40">
                        <TextBlock Text="Dragon VPN" FontSize="34" FontWeight="Bold" />
                        <TextBlock Text="Anonymous Keys" Foreground="#33D6FF" FontSize="19" FontWeight="Bold" Margin="0,6" />
                    </StackPanel>
                    <Button x:Name="NavConfiguration" Content="▱    Конфигурация" Tag="configuration" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" />
                    <Button x:Name="NavGroups" Content="▤    Группы" Tag="groups" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" />
                    <Button x:Name="NavRoutes" Content="⑂    Маршруты" Tag="routes" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" />
                    <Button x:Name="NavApps" Content="▦    Выбор приложений" Tag="apps" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" />
                    <Button x:Name="NavSettings" Content="⚙    Настройки" Tag="settings" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" Background="#66200040" Foreground="#33D6FF" />
                    <Separator Margin="44,8" Background="#958A9F" />
                    <Button x:Name="NavLogs" Content="▣    Журналы" Tag="logs" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" />
                    <Button x:Name="NavTools" Content="⟲    Инструменты" Tag="tools" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" />
                    <Separator Margin="44,8" Background="#958A9F" />
                    <Button x:Name="NavDocuments" Content="▱    Документы" Tag="documents" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" />
                    <Button x:Name="NavAbout" Content="ⓘ    О приложении" Tag="about" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" />
                    <Button x:Name="NavUpdate" Content="◴    Проверить обновление" Tag="update" Style="{StaticResource DrawerButton}" Click="DrawerNavigation_Click" Margin="0,0,0,30" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
