<Application x:Class="DragonVPN.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#09070F" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0E0B15" />
        <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#211A2B" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#B16CFF" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#33D6FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2EDF8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#CEC4D8" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#7A32D6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#211A2B" />
            <Setter Property="BorderBrush" Value="#443A4D" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#160025" />
            <Setter Property="Background" Value="#CEC4D8" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Application.Resources>
</Application>
